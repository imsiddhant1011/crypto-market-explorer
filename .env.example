# =============================================================================
#  Crypto Market Data Explorer - example environment file
# =============================================================================
#  Copy this file to `.env` in the project root to override the development
#  defaults used by docker-compose.yml:
#
#      cp .env.example .env
#
#  The application starts with the defaults below even if you never create a
#  `.env` file. These credentials are intentionally simple local-development
#  values: they are not secrets and must not be reused anywhere else.
# =============================================================================

# PostgreSQL container
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_dev_password
POSTGRES_DB=crypto_market_explorer
# Separate database used only by the pytest suite.
TEST_DB=crypto_test
# Host port mapped to PostgreSQL (change it if 5432 is already in use).
POSTGRES_PORT=5432

# Host ports for the application
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Backend tuning (optional)
# Seconds a request waits for a free pooled database connection before giving up.
DB_POOL_TIMEOUT=5
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
